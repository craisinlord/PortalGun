{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "${logo_file}",
  "environment": "*",
  "entrypoints": {"main": ["com.craisinlord.portalgun.fabric.PortalGunFabric"], "client": ["com.craisinlord.portalgun.fabric.PortalGunFabricClient"]},
  "breaks": {"antarchy": "*"},
  "depends": {"anthology": ">=${anthology_version}", "fabricloader": ">=${fabric_loader_version}", "minecraft": "~${minecraft_version}", "java": ">=17", "fabric-api": "*", "geckolib": ">=${geckolib_version}"},
  "mixins": ["portal_gun.mixins.json", "portal_gun-fabric.mixins.json"]
}
